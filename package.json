{
  "name": "kippu-navi",
  "version": "4.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "cd calculation-engine && go run ./cmd/api",
    "generate:pass-fares": "cd calculation-engine && mkdir -p data/precomputed && go run ./cmd/precompute-pass-fares internal/graphdata/edges.json ./data/precomputed/pass.bin",
    "generate:ticket-fares": "cd calculation-engine && mkdir -p data/precomputed && go run ./cmd/precompute-ticket-fares ./data/precomputed/ticket.bin",
    "build": "node scripts/build-frontend.mjs",
    "start": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "knip": "knip",
    "test:worker": "node --test tests/worker/*.test.mjs",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-local-engine.mjs",
    "dev:engine": "node scripts/prepare-local-engine.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@sentry/browser": "^11.1.0",
    "astro": "^7.3.5",
    "posthog-js": "^1.436.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sentry/vite-plugin": "^5.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.1.0",
    "knip": "^6.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@sentry/cli": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
