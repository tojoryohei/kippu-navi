---
import Layout from "@/layouts/Layout.astro";
import { articles } from "@/data/articles";
interface Props { slug: string; sources: { title: string; url: string }[]; }
const { slug, sources } = Astro.props;
const article = articles.find(a => a.slug === slug)!;
const updated = "2026-10-19";
const published = ["split-ticket-case-study", "calculation-scope"].includes(slug) ? updated : "2026-07-17";
const path = `/articles/${slug}`;
const metadata = {title: article.title, description: article.description, alternates: {canonical: path}};
const jsonLd = {"@context":"https://schema.org","@type":"Article",headline:article.title,description:article.description,url:`https://kippu-navi.com${path}`,datePublished:published,dateModified:updated,author:{"@type":"Person",name:"きっぷナビ運営者",url:"https://kippu-navi.com/about"}};
---
<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="パンくず" class="mb-6 text-sm"><a href="/articles">解説記事</a> / {article.category}</nav>
    <article class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-10">
      <header class="mb-8 border-b border-slate-200 pb-6">
        <p class="text-sm text-blue-700">{article.category}</p>
        <h1 class="mt-3 text-2xl font-bold leading-relaxed sm:text-3xl">{article.title}</h1>
        <p class="mt-4 text-sm text-slate-600">著者：<a href="/about">きっぷナビ運営者</a></p>
        <p class="mt-2 text-sm text-slate-600">公開日：<time datetime={published}>{published}</time> / 更新・内容確認日：<time datetime={updated}>{updated}</time></p>
        <p class="mt-4 text-slate-600">{article.description}</p>
      </header>
      <div class="article-body"><slot /></div>
      <section class="mt-10 border-t border-slate-200 pt-6" aria-label="参照資料">
        <h2 class="text-lg font-bold">参照した一次資料</h2>
        <p class="mt-2 text-sm text-slate-600">上記確認日時点の案内を参照しています。発売条件・運賃は乗車日と利用区間に応じて公式案内でも確認してください。</p>
        <ul class="mt-3 space-y-3">{sources.map(source => <li><a href={source.url}>{source.title}</a></li>)}</ul>
      </section>
      <nav aria-label="関連記事" class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-lg font-bold">あわせて読む</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">{articles.filter(a => a.slug !== slug).map(a => <li><a href={`/articles/${a.slug}`}>{a.title}</a></li>)}</ul>
      </nav>
    </article>
  </div>
</Layout>
<style>
  article :global(a) { color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; }
  .article-body { color: #334155; line-height: 1.95; overflow-wrap: anywhere; }
  .article-body :global(h2) { font-size: 1.35rem; font-weight: 700; margin: 2rem 0 1rem; color: #0f172a; }
  .article-body :global(h3) { font-weight: 700; margin: 1.5rem 0 .75rem; }
  .article-body :global(p) { margin: .8rem 0; }
  .article-body :global(ul), .article-body :global(ol) { padding-left: 1.4rem; list-style: revert; }
  .article-body :global(table) { border-collapse: collapse; width: 100%; font-size: .9rem; }
  .article-body :global(th), .article-body :global(td) { border: 1px solid #cbd5e1; padding: .6rem; text-align: left; }
  .article-body :global(th) { background: #f1f5f9; }
  .article-body :global(details) { margin: 1rem 0; }
</style>
