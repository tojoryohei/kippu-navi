---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="group border border-slate-200 rounded-xl p-4 bg-slate-50/50">
  <summary
    class="flex justify-between items-center font-bold cursor-pointer list-none text-slate-800"
  >
    <span>{title}</span>
    <span
      class="transition-transform duration-200 group-open:rotate-180 text-slate-500"
    >
      <svg
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        class="w-5 h-5"><path d="M19 9l-7 7-7-7"></path></svg
      >
    </span>
  </summary>
  <div
    class="text-slate-800 mt-3 text-sm leading-relaxed border-t border-slate-100 pt-3 space-y-2"
  >
    <slot />
  </div>
</details>
