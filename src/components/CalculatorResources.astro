---
interface ResourceLink {
  href: string;
  title: string;
  description: string;
}

interface Props {
  links: ResourceLink[];
}

const { links } = Astro.props;
const visibleLinks = [...links,
  { href: "/articles/calculation-scope", title: "計算の対象と注意点", description: "対応券種・経路の探索範囲・購入前の確認事項。" },
  { href: "/articles/split-ticket-case-study", title: "実際の計算例", description: "経路・各券の金額と、安くならない例を確認。" },
].filter((link, index, all) => all.findIndex(item => item.href === link.href) === index);
---

<section
  class="calculator-card mt-6 p-5 sm:p-6"
  aria-labelledby="calculator-resources-title"
>
  <h2 id="calculator-resources-title" class="text-lg font-bold text-slate-800">
    関連情報
  </h2>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      visibleLinks.map((link) => (
        <a
          href={link.href}
          class="group rounded-xl border border-slate-200 bg-slate-50 p-4 transition-colors hover:border-blue-300 hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
        >
          <span class="flex items-center justify-between gap-2 font-bold text-blue-700">
            {link.title}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
          <span class="mt-1.5 block text-xs leading-relaxed text-slate-600">
            {link.description}
          </span>
        </a>
      ))
    }
  </div>
</section>
