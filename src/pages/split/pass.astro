---
import Layout from "@/layouts/Layout.astro";
import { RiScissorsFill } from "react-icons/ri";
import CalculatorResources from "@/components/CalculatorResources.astro";

const metadata = {
  title: "JR分割定期券計算機",
  description:
    "JR在来線の通勤定期券を分割購入した場合の最安パターンを自動計算。1箇月・3箇月・6箇月に対応。発駅と着駅を入力するだけで、定期代の節約額がわかります。",
  alternates: {
    canonical: "/split/pass",
  },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "JR分割定期券計算機",
  description:
    "JR在来線の通勤定期券を分割購入した場合の最安パターンを自動計算します。",
  url: "https://kippu-navi.com/split/pass",
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  author: {
    "@type": "Person",
    name: "きっぷナビ運営者",
    url: "https://kippu-navi.com/about",
  },
};

import Calculator from "@/app/split/components/FormWithSearchParams";
---

<Layout metadata={metadata}>
  <>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <div class="py-12 px-4 sm:px-6 lg:px-8">
      <main class="max-w-xl mx-auto">
        <div class="text-center mb-8">
          <div
            class="inline-flex items-center justify-center p-4 bg-blue-100 rounded-full mb-4 shadow-sm"
          >
            <RiScissorsFill className="w-8 h-8 text-blue-600" />
          </div>
          <h1
            class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3"
          >
            {"JR分割定期券計算機"}
          </h1>
          <p class="text-sm sm:text-base text-slate-600 min-h-20">
            {"計算したい区間の発着駅と期間を入力・選択してください。"}
            <br class="hidden sm:block" />
            {"最安となる分割パターンを自動で導出します。"}
          </p>
        </div>

        <div
          class="bg-white p-6 sm:p-10 rounded-2xl shadow-sm border border-slate-200"
        >
          <Calculator
            pathname="/split/pass"
            client:load
            transition:persist="split-calculator"
          />
        </div>

        <CalculatorResources
          links={[
            { href: "/guide#how-to-search", title: "使い方", description: "駅と定期期間の入力方法を確認します。" },
            { href: "/guide#how-to-buy", title: "購入方法", description: "分割定期券を購入する手順を確認します。" },
            { href: "/articles/how-to-buy-split-pass", title: "分割定期券の買い方", description: "購入時の注意点を画像付きで解説します。" },
          ]}
        />
      </main>
    </div>
  </>
</Layout>
