---
import Layout from "@/layouts/Layout.astro";
import { articles } from "@/data/articles";
const metadata = { title: "解説記事", description: "分割きっぷの仕組み、購入・利用条件、実際の計算例と計算範囲を一次資料とともに解説します。", alternates: {canonical: "/articles"} };
const categories = ["仕組み", "購入・利用", "検証・計算範囲"];
---
<Layout metadata={metadata}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-slate-900">解説記事</h1>
    <p class="mt-4 leading-relaxed text-slate-600">分割きっぷの仕組み、画像付きの購入手順、具体的な区間の計算例を紹介しています。</p>
    {categories.map(category => <section class="mt-10"><h2 class="mb-4 text-xl font-bold">{category}</h2><div class="grid gap-4 sm:grid-cols-2">{articles.filter(a => a.category === category).map(a => <a href={`/articles/${a.slug}`} class="rounded-xl border border-slate-200 bg-white p-6 hover:border-blue-400"><h3 class="text-lg font-bold text-blue-700">{a.title}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{a.description}</p></a>)}</div></section>)}
  </div>
</Layout>
