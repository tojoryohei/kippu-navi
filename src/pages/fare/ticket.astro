---
import Layout from "@/layouts/Layout.astro";
import { RiGuideLine } from "react-icons/ri";
import CalculatorResources from "@/components/CalculatorResources.astro";

const metadata = {
  title: "JR乗車券運賃計算機",
  description:
    "JR全線の乗車券の運賃と営業キロを正確に計算。発着駅と経由路線を入力して、特定区間運賃や大都市近郊区間の最安経路補正に対応して計算します。",
  alternates: {
    canonical: "/fare/ticket",
  },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "JR乗車券運賃計算機",
  description: "JR全線の乗車券の運賃と営業キロを正確に計算するプログラムです。",
  url: "https://kippu-navi.com/fare/ticket",
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "JPY",
  },
  author: {
    "@type": "Person",
    name: "きっぷナビ運営者",
    url: "https://kippu-navi.com/about",
  },
};

import Calculator from "@/app/fare/components/FormWithSearchParams";
---

<Layout metadata={metadata}>
  <>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <div class="py-12 px-4 sm:px-6 lg:px-8">
      <main class="max-w-xl mx-auto">
        {/* ページヘッダー領域 */}
        <div class="text-center mb-8">
          <div
            class="inline-flex items-center justify-center p-4 bg-slate-100 rounded-full mb-4 shadow-sm"
          >
            <RiGuideLine className="w-8 h-8 text-slate-700" />
          </div>
          <h1
            class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3"
          >
            {"JR乗車券運賃計算機"}
          </h1>

          <div class="text-sm sm:text-base text-slate-600 leading-relaxed mb-5">
            <p>
              {"発着駅および経由路線を入力してください。"}
            </p>
            <p>
              {"乗車券の運賃を計算します。"}
            </p>
          </div>
        </div>

        {/* フォーム領域（カードスタイル） */}
        <div
          class="bg-white p-6 sm:p-10 rounded-2xl shadow-sm border border-slate-200"
        >
          <Calculator
            pathname="/fare/ticket"
            client:load
            transition:persist="fare-calculator"
          />
        </div>

        <CalculatorResources
          links={[
            { href: "/guide#how-to-search", title: "使い方", description: "駅と経由路線の入力方法を確認します。" },
            { href: "/logic", title: "計算の仕組み", description: "運賃計算エンジンの技術情報を紹介します。" },
            { href: "/articles/jr-fare-system", title: "JR運賃の解説", description: "距離と運賃の関係や制度を解説します。" },
          ]}
        />
      </main>
    </div>
  </>
</Layout>
